# Rempli au démarrage du conteneur par l'image nginx (envsubst), écrit dans
# /tmp/copilot-settings.conf puis inclus dans le bloc server de nginx.conf.
# Les valeurs viennent de docker-compose.main-app.yml (service main-app-gateway).
set $copilot_admin_api_key "${MAIN_APP_CHATBOT_ADMIN_API_KEY}";
set $copilot_public_url    "${MAIN_APP_CHATBOT_PUBLIC_URL}";
