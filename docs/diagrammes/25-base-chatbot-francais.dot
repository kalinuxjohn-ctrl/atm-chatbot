legende [label=<<TABLE BORDER="1" COLOR="#cbd5e0" CELLBORDER="0" CELLPADDING="9"><TR><TD ALIGN="LEFT"><B>Lecture du diagramme</B></TD></TR><TR><TD ALIGN="LEFT">PK : cle primaire | FK : cle etrangere | ? : nullable</TD></TR><TR><TD ALIGN="LEFT">1 : obligatoire | 0..1 : facultatif | 0..* : plusieurs</TD></TR><TR><TD ALIGN="LEFT">Chaque trait relie une FK a sa table de reference.</TD></TR><TR><TD ALIGN="LEFT">Les noms des colonnes et types SQL sont conserves.</TD></TR><TR><TD ALIGN="LEFT">contexte_conversation.context contient aussi la memoire resumee.</TD></TR><TR><TD ALIGN="LEFT">panne_frequente est independante (aucune FK).</TD></TR></TABLE>>];
