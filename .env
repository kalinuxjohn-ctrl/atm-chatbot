# Copier ce fichier en ".env" et remplir avec les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (à ajouter dans .gitignore).

# Le "+psycopg2" est important : sans lui, SQLAlchemy 2.x essaie d'utiliser
# psycopg (v3, pas installé) au lieu de psycopg2-binary et l'app plante au démarrage.
DATABASE_URL=postgresql+psycopg2://atm_user:changeme@localhost:5432/atm_chatbot

# Ollama tourne en local, pas de clé API nécessaire — juste l'adresse et le
# nom du modèle installé (ex: `ollama pull llama3.1`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Moteur de vecteurs : à remplir une fois la solution choisie.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_DIMENSIONS=
