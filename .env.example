# ============================================================================
# Modèle de .env : copier en .env et remplir. Ne jamais committer .env.
# ============================================================================

# Nom public applique aux pages et a la navigation lors du build Docker.
APP_NAME=atm-chatbot

# --- Chatbot (existant) -------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@db:5432/atm_chatbot
HF_HOME=/root/.cache/huggingface
LLM_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=
EMBEDDING_DIMENSIONS=1024
SYMPTOM_SIMILARITY_THRESHOLD=
ADMIN_API_KEY=
PHOTO_OCR_ENABLED=true

# --- Main app (application des techniciens, voir docs/main-app.md) ----------
# Lancement : docker compose -f docker-compose.yml -f docker-compose.main-app.yml up -d --build

# Mot de passe du rôle SQL main_app_user (OBLIGATOIRE, 16 caractères minimum).
# Lettres et chiffres conseillés, ex. : openssl rand -hex 24
MAIN_APP_DATABASE_PASSWORD=

# production (défaut) ou development. En production, MAIN_APP_COOKIE_SECURE=false est refusé.
MAIN_APP_ENVIRONMENT=production
# true = cookie de session envoyé en HTTPS uniquement. false SEULEMENT en développement HTTP.
MAIN_APP_COOKIE_SECURE=true
MAIN_APP_SESSION_DURATION_HOURS=12
# DÉVELOPPEMENT SEULEMENT (refusé si MAIN_APP_ENVIRONMENT=production) : désactive
# la connexion, toute requête sans session agit en tant que ce compte existant.
MAIN_APP_DEVELOPMENT_AUTO_LOGIN_USERNAME=

# Inscription libre (register.html). false : seuls les administrateurs créent les comptes.
MAIN_APP_ALLOW_REGISTRATION=false
MAIN_APP_LOGIN_MAX_FAILED_ATTEMPTS=5
MAIN_APP_LOGIN_LOCK_MINUTES=15

# Fond de carte : gabarit FIXE du fournisseur de tuiles (relayées par le serveur).
# OpenStreetMap convient pour un usage modéré ; pour un usage soutenu, prendre un
# fournisseur avec clé (la clé reste ici, côté serveur, jamais dans le navigateur).
MAIN_APP_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAIN_APP_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Exigé par la politique d'usage d'OpenStreetMap : nom de l'app + contact.
MAIN_APP_MAP_TILE_USER_AGENT=atm-main-app/1.0 (contact: exploitation@exemple.fr)
MAIN_APP_MAP_TILE_MAX_ZOOM=19
MAIN_APP_MAP_TILE_CACHE_ENTRIES=2000

# Itineraires OpenRouteService : cle cote serveur uniquement.
# Sans cle, la carte reste utilisable mais le calcul d'itineraire est desactive.
MAIN_APP_MAP_ROUTING_API_KEY=

# Taille maximale d'une pièce jointe (octets). Le gateway accepte au plus 12 Mo.
MAIN_APP_UPLOAD_MAX_BYTES=10485760

# Adresse publique EXACTE de l'app (schéma + hôte + port) : seule origine
# autorisée à ouvrir le WebSocket des appels.
MAIN_APP_PUBLIC_ORIGIN=http://localhost:8080
# Serveurs STUN/TURN (JSON). Vide = STUN public de Google, pas de TURN.
# MAIN_APP_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemple.fr:3478","username":"...","credential":"..."}]
MAIN_APP_ICE_SERVERS=

# Port publié par le gateway, et sur quelle adresse (127.0.0.1 = cette machine seulement).
MAIN_APP_GATEWAY_PORT=8080
MAIN_APP_GATEWAY_PUBLISHED_ADDRESS=127.0.0.1

# ATM-Chatbot derrière l'Espace techniciens : secret partagé entre le gateway et
# l'API du chatbot (prouve que le technicien transmis a bien été vérifié).
# OBLIGATOIRE, au moins 32 caractères : openssl rand -hex 32
# L'administration de l’ATM-Chatbot réutilise ADMIN_API_KEY (ci-dessus), ajoutée par le gateway.
ATM_CHATBOT_GATEWAY_SHARED_SECRET=

# --- Lanceur local Windows / WSL : .\start.ps1 ou bash start.sh --------------
# Ces ports ne sont publies que sur 127.0.0.1 avec docker-compose.local.yml.
# MAIN_APP_GATEWAY_PORT ci-dessus reste le port de l'application (8080).
CHATBOT_API_PORT=8000
DB_PORT=5432
# Le lanceur local conserve les donnees et desactive le seed de demonstration.
# Hors lanceur local, le comportement historique reste SEED_DEMO_DATA=true.
SEED_DEMO_DATA=true
